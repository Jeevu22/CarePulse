# Copy to .env and fill in for local `python app.py` runs.

ENVIRONMENT=development

# Leave as SQLite for zero-setup local dev, or point at Postgres:
# DATABASE_URL=postgresql://pulsewatch:pulsewatch@localhost:5432/pulsewatch
DATABASE_URL=sqlite:///pulsewatch_dev.db

# Path to a real Firebase service-account JSON to enable real auth.
# If this file doesn't exist, the backend falls back to mock auth
# (mock-user-123) and /api/health reports firebase_connected: false.
FIREBASE_CREDENTIALS_PATH=firebase-key.json

# Set true to reject unauthenticated requests even in mock mode.
ENFORCE_AUTH=false

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
